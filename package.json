{
  "name": "pagesure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Machine-payment gateway for APIs and digital services. HTTP-native Stellar MPP payments with provider policy enforcement.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "mpp:audit": "tsx scripts/audit-mpp-api.ts",
    "contracts:build": "bash scripts/build-contracts.sh --build",
    "channels:deploy": "tsx scripts/deploy-contracts.ts",
    "keys:generate": "tsx scripts/generate-keys.ts"
  },
  "dependencies": {
    "@stellar/mpp": "0.7.1",
    "@stellar/stellar-sdk": "15.1.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "mppx": "0.6.31",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.51.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
