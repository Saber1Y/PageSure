# Stellar testnet only. Generate real keys with: npm run keys:generate
# Never commit a .env file. See .env.example for the full documented list.

# ---- Core ----
DATABASE_URL=./data/pagesure.db
MPP_SECRET_KEY=
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ---- Provider (the service provider / recipient wallet) ----
PROVIDER_RECIPIENT_G=
PROVIDER_LABEL="PageSure Demo Provider"

# Sponsors transaction fees so payers never pay network fees.
# PageSure requires this. A per-wallet rate limit is enforced before any
# challenge is issued, because mppx's own docs warn about fee-exhaustion DoS.
FEE_PAYER_SECRET=

# ---- Demo payer (the agent) ----
DEMO_PAYER_SECRET=
DEMO_PAYER_G=

# Raw 64-hex ed25519 seed used for the agent's channel commitments.
# This is NOT an S... Stellar secret. The matching public key must equal the
# commitmentKey baked into each channel at open() time.
AGENT_COMMITMENT_SEED=

# ---- Channel contract deployment (see docs/channel-lifecycle.md) ----
# Built from stellar-experimental/one-way-channel, uploaded once.
CHANNEL_WASM_HASH=
# channel-factory contract id, deployed once.
CHANNEL_FACTORY_C=
CHANNEL_FACTORY_ADMIN_G=

# ---- Upstream providers (strict mode: unconfigured = loud failure) ----
PAGESURE_UPSTREAM_MODE=strict
PAGESURE_ALLOW_LOCAL_UPSTREAM=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
# Optional. The market adapter uses CoinGecko's keyless public endpoint;
# this key only raises rate limits.
COINGECKO_API_KEY=
# Any OpenAI-compatible chat completions endpoint. OpenRouter, OpenAI and Ollama
# all work unmodified. Anthropic and Gemini are not OpenAI-compatible natively.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Dashboard auth ----
PROVIDER_ADMIN_EMAIL=
PROVIDER_ADMIN_PASSWORD=
SESSION_SECRET=

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- App ----
APP_URL=http://localhost:3000