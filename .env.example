# Stellar testnet only. Generate real keys with: npm run keys:generate
# Never commit a .env file. See .env.example for the full documented list.

# ---- Core ----
DATABASE_URL=./data/pagesure.db
MPP_SECRET_KEY=
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ---- Provider (the service provider / recipient wallet) ----
PROVIDER_RECIPIENT_G=
PROVIDER_LABEL="PageSure Demo Provider"

# Sponsors transaction fees so payers never pay network fees.
# PageSure requires this. A per-wallet rate limit is enforced before any
# challenge is issued, because mppx's own docs warn about fee-exhaustion DoS.
FEE_PAYER_SECRET=

# ---- Demo payer (the agent) ----
DEMO_PAYER_SECRET=
DEMO_PAYER_G=

# ---- Seed data (npm run db:seed) ----
# Without DEMO_OWNER_WALLET the seed is a silent no-op: it logs
# "DEMO_OWNER_WALLET not set to a valid Stellar key: nothing to seed" and
# creates nothing, so every console page renders its empty state.
#
# This is a SHORTCUT, not the only way to get a service. /services/new creates
# one in your own organization and will create a default policy if you have
# none. Use the seed for the channel-mode service, which the form cannot yet
# provision.
#
# This wallet becomes the owner of the "PageSure Demo" organization, which is
# a DIFFERENT organization from any created by signing up through /login. The
# seed's organization never merges with yours, so seeding does not put services
# into the organization you actually sign in to.
DEMO_OWNER_WALLET=

# Where settled payments are sent. Defaults to DEMO_OWNER_WALLET when unset.
# Must be a valid Stellar account or the seed throws.
DEMO_SETTLEMENT_RECIPIENT=

# med25519 G... key for channel-mode services. Must decode to 32 bytes or the
# seed throws. Leave unset to skip the channel-mode service.
DEMO_COMMITMENT_PUBLIC_KEY=

# Display name for the seeded owner. Defaults to "PageSure Demo".
PROVIDER_LABEL=

# Raw 64-hex ed25519 seed used for the agent's channel commitments.
# This is NOT an S... Stellar secret. The matching public key must equal the
# commitmentKey baked into each channel at open() time.
AGENT_COMMITMENT_SEED=

# ---- Channel contract deployment (see docs/channel-lifecycle.md) ----
# Built from stellar-experimental/one-way-channel, uploaded once.
CHANNEL_WASM_HASH=
# channel-factory contract id, deployed once.
CHANNEL_FACTORY_C=
CHANNEL_FACTORY_ADMIN_G=

# ---- Upstream providers (strict mode: unconfigured = loud failure) ----
PAGESURE_UPSTREAM_MODE=strict
PAGESURE_ALLOW_LOCAL_UPSTREAM=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
# Optional. The market adapter uses CoinGecko's keyless public endpoint;
# this key only raises rate limits.
COINGECKO_API_KEY=
# Any OpenAI-compatible chat completions endpoint. OpenRouter, OpenAI and Ollama
# all work unmodified. Anthropic and Gemini are not OpenAI-compatible natively.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Console auth ----
# There is no admin password and no seeded account. Console access is granted by
# proving control of PROVIDER_RECIPIENT_G above: sign a server-issued challenge with
# that key. The operator row is created on the first successful proof, and WebAuthn
# passkeys can then be registered from the signed-in console.
#
# SESSION_SECRET signs the session cookie. Minimum 32 characters.
SESSION_SECRET=

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- App ----
APP_URL=http://localhost:3000

# Email delivery. Email is the primary credential, so a deployment with no provider configured
# refuses to send rather than reporting a success nobody receives. Without RESEND_API_KEY, and
# outside production, links are printed to the server console instead.
#
# PAGESURE_PUBLIC_ORIGIN overrides APP_URL for building sign-in and invitation links. Set it
# when the two differ - for example when the app is reached through a tunnel or a proxy.
# PAGESURE_PUBLIC_ORIGIN=https://pagesure.example.com
#
# Read the sender restriction before assuming a key is enough, because this is the failure that
# looks like the app being broken.
#
# Leaving MAIL_FROM unset sends from Resend's `onboarding@resend.dev`, and Resend only delivers
# that sender to the email address registered on the Resend account itself. Sign in to Resend as
# the address you expect to receive at, and it works. Sign in as a different one and every
# message is silently dropped - no error, and this code faithfully reports success, because the
# provider accepted the request and then declined to deliver it.
#
# To send to arbitrary addresses, verify a domain you control (Resend issues SPF and DKIM DNS
# records) and set MAIL_FROM to it:
# MAIL_FROM="PageSure <login@your-domain.example>"
#
# RESEND_API_KEY=

# Print sign-in and invitation links to the console instead of sending them. Development only;
# setting it to "off" makes an unconfigured deployment fail loudly, which is what you want
# anywhere real.
# PAGESURE_DEV_MAIL=on

# External channel signer. The signer URL must match one of these hosts exactly, and the token
# must come from the environment variable named here - PageSure stores the name, never the
# value.
# MPP_SIGNER_HOSTS=signer.example.com
# MPP_SIGNER_TOKEN_PREFIX=signer_