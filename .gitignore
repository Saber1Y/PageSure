# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
next-env.d.ts

# database (SQLite lives in data/)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# backups nest one level deeper, so data/*.db does not reach them, and a backup of a live
# database is exactly the file nobody wants committed
data/backups/

# built channel WASM (built from stellar-experimental/one-way-channel, not vendored)
*.wasm

# env
.env
.env.local
.env.development.local
.env.*.local

# typescript / misc
*.tsbuildinfo
.DS_Store
*.log